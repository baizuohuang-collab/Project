//Manager 類別 負責： 新增資料 刪除資料 搜尋資料 統計資料
/*class Manager
{
    public:

    private:
        Manager();
        ~Manager();
        Manager(const Manager& other);
};
*/

template <typename T>
class Manager {
private:
    vector<T> data;   // 用來存資料

public:
    // 新增資料
    void add(const T& item) 
    {
        data.push_back(item);
    }

    // 刪除資料（刪除第一個符合的）
    bool remove(const T& item) 
    {
        auto it = find(data.begin(), data.end(), item);
        if (it != data.end()) 
        {
            data.erase(it);
            return true;
        }
        return false;
    }

    // 搜尋資料（回傳是否存在）
    bool search(const T& item) const 
    {
        return find(data.begin(), data.end(), item) != data.end();
    }

    // 統計資料（回傳資料筆數）
    size_t count() const 
    {
        return data.size();
    }

    // 顯示所有資料（方便測試）
    void printAll() const 
    {
        for (const auto& item : data) 
        {
            cout << item << "\n";
        }
    }
};


int main ()
{
    return 0;
}

void showMenu() {
    cout << "\n===== MENU =====\n";
    cout << "1. Add data\n";
    cout << "2. Remove data\n";
    cout << "3. Search data\n";
    cout << "4. Count data\n";
    cout << "5. Show all\n";
    cout << "0. Exit\n";
    cout << "Choose: ";
}

int main() {
    int choice;
    string input;

    while (true) {
        showMenu();
        cin >> choice;

        // 防止 cin 跳過輸入
        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        switch (choice) {
            case 1:
                cout << "Enter data to add: ";
                getline(cin, input);
                // manager.add(input);
                break;

            case 2:
                cout << "Enter data to remove: ";
                getline(cin, input);
                // manager.remove(input);
                break;

            case 3:
                cout << "Enter data to search: ";
                getline(cin, input);
                // if (manager.search(input)) cout << "Found!\n";
                // else cout << "Not found.\n";
                break;

            case 4:
                // cout << "Count: " << manager.count() << endl;
                break;

            case 5:
                // manager.printAll();
                break;

            case 0:
                cout << "Bye!\n";
                return 0;

            default:
                cout << "Invalid choice.\n";
        }
    }
}

