using namespace std;

//Object section
//event is for users to write down the events
class Event 
{ 
    public: 
        static int counter;// to know how many events have created and also to record their ID 
        static vector<bool> activeIDs;//to record who is active 
        string ID;
        string date; 
        string time; 
        string category; 
        string description;
    private:
        Event(const string date,const string time,const string category);
        ~Event();
        Event(const Event& other);//copy everything but the ID will append to the last one therefore it's hard to delete 
};  
Event::Event(const string date,const string time,const string category)
{
    this->date = date;
    this->time = time;
    this->category = category;
    this->ID = this->counter;
    this->activeIDs.push_back(true);
    this->counter++;
}
/*Event::~Event()
{
    for (int i=0;i<this->counter;i++)
    {
        if (this->activeIDs[i]==true)
        {
            this->activeIDs[i] = false;
            this->counter--;
        }
    }

}*/
Event::~Event() noexcept
{
    try {
        for (int i = 0; i < this->counter; ++i)
        {
            // Bounds check (defensive)
            if (i < 0 || i >= this->counter) 
            {
                throw out_of_range("activeIDs index out of range in destructor");
            }

            if (this->activeIDs[i]) 
            {
                this->activeIDs[i] = false;
            }
        }

        // Reset counter AFTER loop (your original code decremented inside the loop — dangerous)
        this->counter--;
    }
    catch (const exception& e) 
    {
        cerr << "[Warning] Exception in Event destructor: "<< e.what() <<endl;
    }
}
Event::Event(const Event& other)
{
    this->category = other.category;
    this->date = other.date;
    this->time = other.time;
    this->ID= other.counter;
    this->activeIDs.push_back(true);
}

// Initialize static members
int Event::counter = 0;
vector<bool> Event::activeIDs;

