#include "resource.h"
#include <windows.h>

IDD_CUSTOMMSG DIALOGEX 0, 0, 240, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Reminder"
FONT 10, "Segoe UI"
BEGIN
    LTEXT           "", IDC_TEXT, 15, 15, 210, 50
    DEFPUSHBUTTON   "OK", IDOK, 70, 80, 40, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 130, 80, 40, 14
END
